{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "properties": {
    "data": {
      "dataFieldType": "table",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "唯一标识ID（如绩效记录ID）"
          },
          "deptName": {
            "type": "string",
            "description": "部门"
          },
          "name": {
            "type": "string",
            "description": "姓名"
          },
          "staffNo": {
            "type": "string",
            "description": "编号（员工工号）"
          },
          "position": {
            "type": "string",
            "description": "岗位"
          },
          "positionSequence": {
            "type": "string",
            "description": "岗位序列"
          },
          "salaryCompanyName": {
            "type": "string",
            "description": "工资发放公司"
          },
          "duePerformance": {
            "type": "number",
            "minimum": 0,
            "description": "应发绩效"
          },
          "actualPerformance": {
            "type": "number",
            "minimum": 0,
            "description": "实发绩效"
          },
          "idCardNumber": {
            "type": "string",
            "description": "身份证号"
          },
          "employeeCategory": {
            "type": "string",
            "description": "员工类别"
          },
          "quarterFirstMonthPerformance": {
            "type": "number",
            "minimum": 0,
            "description": "季度首月绩效"
          },
          "quarterMiddleMonthPerformance": {
            "type": "number",
            "minimum": 0,
            "description": "季度次月绩效"
          },
          "quarterLastMonthPerformance": {
            "type": "number",
            "minimum": 0,
            "description": "季度末月绩效"
          },
          "performanceDifference": {
            "type": "number",
            "description": "绩效差异（应发-实发）"
          }
        }
      }
    },
    "quarter" : {
      "dataFieldType": "text",
      "type": "string",
      "description": "季度"
    }
  },
  "type": "object"
}