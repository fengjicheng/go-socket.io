{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "员工薪资月度记录",
  "description": "记录员工月度薪资、部门和福利信息",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "唯一标识ID"
    },
    "createdTime": {
      "type": "string",
      "format": "date-time",
      "description": "记录创建时间"
    },
    "modifiedTime": {
      "type": "string",
      "format": "date-time",
      "description": "记录修改时间"
    },
    "creator": {
      "type": "string",
      "description": "创建者ID"
    },
    "modifier": {
      "type": "string",
      "description": "修改者ID"
    },
    "deleteFlag": {
      "type": "boolean",
      "description": "删除标记"
    },
    "bizMonth": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "业务月份，格式YYYY-MM"
    },
    "deptCode": {
      "type": "string",
      "description": "部门编码"
    },
    "deptName": {
      "type": "string",
      "description": "部门名称"
    },
    "name": {
      "type": "string",
      "description": "员工姓名"
    },
    "staffNo": {
      "type": "string",
      "description": "员工工号"
    },
    "position": {
      "type": "string",
      "description": "职位名称"
    },
    "positionSequence": {
      "type": "string",
      "description": "职位序列"
    },
    "employeeType": {
      "type": "string",
      "description": "员工类型"
    },
    "employeeStatus": {
      "type": "string",
      "description": "员工状态"
    },
    "idCardNumber": {
      "type": "string",
      "description": "身份证号码"
    },
    "salaryCompanyCode": {
      "type": "string",
      "description": "薪资核算公司编码"
    },
    "salaryCompanyName": {
      "type": "string",
      "description": "薪资核算公司名称"
    },
    "currentMonthIncome": {
      "type": "number",
      "description": "当月收入"
    },
    "currentMonthPerformance": {
      "type": "number",
      "description": "当月绩效"
    },
    "companyHousingFund": {
      "type": "number",
      "description": "公司缴纳公积金"
    },
    "companyMedicalInsurance": {
      "type": "number",
      "description": "公司缴纳医疗保险"
    },
    "companyPensionInsurance": {
      "type": "number",
      "description": "公司缴纳养老保险"
    },
    "companyUnemploymentInsurance": {
      "type": "number",
      "description": "公司缴纳失业保险"
    },
    "companyWorkInjuryInsurance": {
      "type": "number",
      "description": "公司缴纳工伤保险"
    },
    "currentMonthTotalCost": {
      "type": "number",
      "description": "当月公司总成本"
    }
  },
  "required": [
    "id",
    "createdTime",
    "modifiedTime",
    "creator",
    "modifier",
    "deleteFlag",
    "bizMonth",
    "deptCode",
    "deptName",
    "name",
    "staffNo",
    "position",
    "positionSequence",
    "employeeType",
    "employeeStatus",
    "idCardNumber",
    "salaryCompanyCode",
    "salaryCompanyName",
    "currentMonthIncome",
    "currentMonthPerformance",
    "companyHousingFund",
    "companyMedicalInsurance",
    "companyPensionInsurance",
    "companyUnemploymentInsurance",
    "companyWorkInjuryInsurance",
    "currentMonthTotalCost"
  ],
  "additionalProperties": false
}